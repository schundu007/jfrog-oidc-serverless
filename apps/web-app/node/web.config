<?xml version="1.0" encoding="utf-8"?>
<!-- Windows App Service: iisnode runs server.js; every path goes to it. Linux ignores this file. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="app">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <!-- The app's own error JSON (e.g. 503 from /healthz/jfrog) reaches the caller, not IIS's page. -->
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <iisnode loggingEnabled="false" devErrorsEnabled="false" />
  </system.webServer>
</configuration>
