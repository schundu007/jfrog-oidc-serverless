jfrog_url                = "https://acme.jfrog.io"
jfrog_reader_group       = "serverless-readers"
gcp_project_id           = "my-project"
gcp_region               = "us-central1"
workload                 = "artifact-reader"
deployer_service_account = "ado-build@my-project.iam.gserviceaccount.com"
artifact_path            = "generic-local/config/app.json"
