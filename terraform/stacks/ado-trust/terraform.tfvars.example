jfrog_url             = "https://acme.jfrog.io"
jfrog_reader_group    = "serverless-readers"
ado_org               = "contoso"
azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
azure_subscription_id = "00000000-0000-0000-0000-000000000000"
azure_identity        = { name = "id-ado-contoso", resource_group = "ado-cicd-rg" }
connections = {
  build = { name = "jfrog-oidc-wif", subject = "/eid1/c/pub/t/<tenant>/a/<app>/sc/<org-id>/<connection-id>" }
  setup = { name = "jfrog-oidc-setup", subject = "/eid1/c/pub/t/<tenant>/a/<app>/sc/<org-id>/<connection-id>" }
}
gcp_project_id                = "my-project"
ado_token_audience = "api://AzureADTokenExchange"
# AWS (optional; leave out to skip)
# aws_account_id = "123456789012"
# aws_region     = "us-east-1"

# Console operator identity (console-operator.tf): who may mint the console's short-lived JFrog token
# console_operators = ["user:you@example.com"]
# azure_console_operators = ["<your Entra object id: az ad signed-in-user show --query id -o tsv>"]
