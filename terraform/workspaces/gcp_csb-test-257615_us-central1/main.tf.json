{
  "import": [
    {
      "for_each": "${var.adopt_jfrog_integration ? toset([var.jfrog_provider_name]) : toset([])}",
      "id": "${each.value}",
      "to": "module.jfrog_oidc.platform_oidc_configuration.gcp[0]"
    }
  ],
  "locals": {
    "pull_workloads": "${{ for k in (var.pull_path.enabled ? [var.pull_mapping_name] : []) : k => { cloud = \"gcp\", subject = module.gcp_pull_path[0].rotator_unique_id, username = var.pull_path.registry_username, groups = var.pull_path.groups, expires_in = var.pull_path.ttl_seconds, description = \"Artifact Registry upstream credential (rotated)\" } }}"
  },
  "module": {
    "gcp_pull_path": {
      "alert_after_seconds": "${var.pull_path.alert_after_seconds}",
      "count": "${var.pull_path.enabled ? 1 : 0}",
      "jfrog_audience": "${var.jfrog_audience}",
      "jfrog_provider_name": "${var.jfrog_provider_name}",
      "jfrog_url": "${var.jfrog_url}",
      "min_ttl_seconds": "${var.pull_path.min_ttl_seconds}",
      "name_prefix": "${var.name_prefix}",
      "project_id": "${var.gcp_project_id}",
      "reader_members": "${var.reader_members}",
      "region": "${var.gcp_region}",
      "registry_username": "${var.pull_path.registry_username}",
      "remote_repositories": "${var.remote_repositories}",
      "rotation_schedule": "${var.pull_path.rotation_cron}",
      "rotator_image": "${var.pull_path.rotator_image}",
      "source": "../../modules/gcp-pull-path"
    },
    "jfrog_oidc": {
      "gcp": {
        "audience": "${var.jfrog_audience}",
        "provider_name": "${var.jfrog_provider_name}"
      },
      "project_key": "${var.jfrog_project_key}",
      "source": "../../modules/jfrog-oidc",
      "workloads": "${merge(var.workloads, local.pull_workloads)}"
    }
  },
  "output": {
    "first_run_command": {
      "value": "${one(module.gcp_pull_path[*].first_run_command)}"
    },
    "jfrog_audience": {
      "value": "${module.jfrog_oidc.gcp_audience}"
    },
    "jfrog_provider_name": {
      "value": "${module.jfrog_oidc.gcp_provider_name}"
    },
    "mapping_names": {
      "value": "${keys(merge(var.workloads, local.pull_workloads))}"
    },
    "repository_urls": {
      "value": "${one(module.gcp_pull_path[*].repository_urls)}"
    },
    "rotator_job_name": {
      "value": "${one(module.gcp_pull_path[*].rotator_job_name)}"
    }
  },
  "provider": {
    "google": {
      "project": "${var.gcp_project_id}",
      "region": "${var.gcp_region}"
    },
    "platform": {
      "url": "${var.jfrog_url}"
    }
  },
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": ">= 6.13"
      },
      "platform": {
        "source": "jfrog/platform",
        "version": ">= 2.2.1"
      }
    },
    "required_version": ">= 1.7"
  },
  "variable": {
    "adopt_jfrog_integration": {
      "default": false,
      "type": "bool"
    },
    "gcp_project_id": {
      "type": "string"
    },
    "gcp_region": {
      "type": "string"
    },
    "jfrog_audience": {
      "type": "string"
    },
    "jfrog_project_key": {
      "default": null,
      "type": "string"
    },
    "jfrog_provider_name": {
      "type": "string"
    },
    "jfrog_url": {
      "type": "string"
    },
    "name_prefix": {
      "type": "string"
    },
    "pull_mapping_name": {
      "type": "string"
    },
    "pull_path": {
      "type": "object({enabled = bool, ttl_seconds = number, rotation_cron = string, min_ttl_seconds = number, alert_after_seconds = number, registry_username = string, rotator_image = string, groups = list(string)})"
    },
    "reader_members": {
      "default": [],
      "type": "list(string)"
    },
    "remote_repositories": {
      "default": {},
      "type": "map(object({format = string, upstream_uri = string}))"
    },
    "workloads": {
      "description": "Runtime mappings, one per target: <config>-runtime",
      "type": "map(object({cloud = string, subject = string, username = optional(string), groups = list(string), expires_in = number, description = string}))"
    }
  }
}
